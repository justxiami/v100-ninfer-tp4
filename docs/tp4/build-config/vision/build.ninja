# =============================================================================
# Object build statements for STATIC_LIBRARY target ninfer_text


#############################################
# Order-only phony target for ninfer_text

build cmake_object_order_depends_target_ninfer_text: phony || src/CMakeFiles/ninfer_text.dir

build src/CMakeFiles/ninfer_text.dir/text/unicode.cpp.o: CXX_COMPILER__ninfer_text_unscanned_Release $HOME/src/ninfer-V100X2-remote/src/text/unicode.cpp || cmake_object_order_depends_target_ninfer_text
  DEFINES = -DNINFER_VOLTA_BUILD=1
